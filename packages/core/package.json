{
  "name": "@theographic/core",
  "version": "0.1.0",
  "description": "Theographic search and data model — pure TypeScript, runs in browser workers, Node, and native shells",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist-node/node/index.d.ts",
      "import": "./dist-node/node/index.js"
    }
  },
  "bin": {
    "theographic": "./bin/theographic.mjs"
  },
  "files": [
    "dist",
    "dist-node",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p node/tsconfig.json",
    "test": "vitest run"
  }
}
