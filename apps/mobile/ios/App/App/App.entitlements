<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links. Needs the matching /.well-known/apple-app-site-association
	     on the site (apps/web/public/.well-known/) carrying the Team ID, and the
	     Associated Domains capability on the App ID in the developer portal. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:theographic.netlify.app</string>
	</array>
</dict>
</plist>
