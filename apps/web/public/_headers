# Netlify cache headers.
#
# /_astro/* is content-hashed by Vite: safe to cache for a year.
#
# The five engine files are requested by the search worker with a
# `?v=<sha256 prefix>` query from the manifest (core's fetchSource), so
# every rebuild is a new URL and the old one can be immutable. Nothing on
# the site requests them without the query; the other bundles under /data
# (verses/*.json, detail/*, manifest.json) keep Netlify's default
# revalidation because they are fetched by path alone.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/data/books.json
  Cache-Control: public, max-age=31536000, immutable
/data/entities.index.json
  Cache-Control: public, max-age=31536000, immutable
/data/verses.idx
  Cache-Control: public, max-age=31536000, immutable
/data/verses.txt
  Cache-Control: public, max-age=31536000, immutable
/data/graph.bin
  Cache-Control: public, max-age=31536000, immutable

# Native-app association files (CP-10). Apple requires application/json on
# the extensionless AASA file; Netlify would otherwise send octet-stream.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json
