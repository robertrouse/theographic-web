---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Chapter from '../components/Chapter.astro';
import EntityChips from '../components/EntityChips.astro';
import { getBooks, getBook, resolvePeople } from '../lib/data';
import { chapterHref } from '../lib/refs';
import { formatYear } from '@theographic/core';

export const getStaticPaths = (() =>
  getBooks().map((b) => ({ params: { book: b.slug } }))) satisfies GetStaticPaths;

const book = getBook(Astro.params.book)!;
const writers = resolvePeople(book.writers);
const chapters = Array.from({ length: book.chapterCount }, (_, i) => i + 1);
const single = book.chapterCount === 1;
const testament = book.testament === 'OT' ? 'Old Testament' : 'New Testament';
---

<Base
  title={book.name}
  description={`${book.name}: ${book.chapterCount} ${single ? 'chapter' : 'chapters'}, ${book.verseCount.toLocaleString('en')} verses. ${testament}, ${book.division}.`}
  section="browse"
>
  <header class="page-head">
    <p class="page-head__kicker">{testament} · {book.division}</p>
    <h1>{book.name}</h1>
    <p class="page-head__sub">
      {book.chapterCount}
      {single ? 'chapter' : 'chapters'} · {book.verseCount.toLocaleString('en')} verses
      {book.yearWritten !== undefined && <> · written c. {formatYear(book.yearWritten)}</>}
    </p>
  </header>

  {
    writers.length > 0 && (
      <dl class="facts">
        <dt>{writers.length === 1 ? 'Writer' : 'Writers'}</dt>
        <dd>
          <EntityChips items={writers} label="Writers" />
        </dd>
      </dl>
    )
  }

  {
    single ? (
      <Chapter book={book} chapter={1} heading={false} />
    ) : (
      <nav aria-label="Chapters">
        <ol class="chapter-grid">
          {chapters.map((c) => (
            <li>
              <a href={chapterHref(book.slug, c)} aria-label={`${book.name} chapter ${c}`}>
                {c}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  {/* Old-site anchors: /john/#John.3.16 → /john/3#v16 (invariant 8). */}
  <script is:inline define:vars={{ slug: book.slug, chapters: book.chapterCount }}>
    (function () {
      var m = /^#[1-3]?[A-Za-z]+\.(\d+)(?:\.(\d+))?$/.exec(location.hash);
      if (!m) return;
      var c = parseInt(m[1], 10);
      if (c < 1 || c > chapters) return;
      location.replace('/' + slug + '/' + c + (m[2] ? '#v' + parseInt(m[2], 10) : ''));
    })();
  </script>
</Base>
