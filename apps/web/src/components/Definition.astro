---
/**
 * A block of description text with its provenance. Two sources use it:
 *
 * - a generated definition (CP-08): short prose plus the verses it cites,
 *   rendered as links. Drafts carry an "AI-drafted · model · date" mark;
 *   reviewed rows carry no mark at all (invariant 7).
 * - Easton's Bible Dictionary (1897), shown only while an entity has no
 *   definition. Its first paragraph is the summary at the point of use;
 *   anything after it is one click away behind "Read more", so a long entry
 *   (Easton on Moses runs to 3,000 words) never pushes the timeline and
 *   verses off the page.
 *
 * The component does not know which it is showing; the page decides.
 */
import { renderBlocks, splitParagraphs } from '../lib/markdown';
import { siteLinks } from '../lib/links';
import type { Citation } from '../lib/refs';

interface Props {
  /** Provenance label, e.g. "Easton's Bible Dictionary (1897)". Omit for nothing. */
  source?: string;
  /** Markdown subset: links, italics, blank-line paragraphs. */
  markdown: string;
  /** e.g. "draft" — rendered next to the source label when present. */
  status?: string;
  /** Verses the text rests on, rendered after it as links. */
  citations?: Citation[];
}
const { source, markdown, status, citations } = Astro.props;
const [first = '', ...rest] = splitParagraphs(markdown);
const lead = renderBlocks(first, siteLinks);
const more = rest.length > 0 ? renderBlocks(rest.join('\n\n'), siteLinks) : undefined;
---

<section class="definition" aria-label={source ? `Description from ${source}` : 'Description'}>
  {
    source && (
      <p class="definition__source">
        {source}
        {status && <span> · {status}</span>}
      </p>
    )
  }
  <Fragment set:html={lead} />
  {
    more && (
      <details class="definition__more">
        <summary>Read more</summary>
        <Fragment set:html={more} />
      </details>
    )
  }
  {
    citations && citations.length > 0 && (
      <p class="definition__cites">
        <span class="definition__cites-label">Cites </span>
        {citations.map((c, i) => (
          <>
            {i > 0 && ' · '}
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </p>
    )
  }
</section>
