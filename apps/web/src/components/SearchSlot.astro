---
/**
 * The header search box (CP-07): a React island that hydrates on idle. It
 * carries the engine files' hashes from the manifest so the worker makes no
 * manifest request. Home renders `SearchPage` instead (index.astro).
 */
import { engineManifest } from '@theographic/core';
import HeaderSearch from './search/HeaderSearch';
import { getManifest } from '../lib/data';

interface Props {
  class?: string;
  /** Kept from the CP-06 placeholder; the header box is always compact today. */
  compact?: boolean;
}
const { class: className } = Astro.props;
const manifest = engineManifest(getManifest());
---

<div class={className} data-search-slot>
  <HeaderSearch client:idle manifest={manifest} />
</div>
